{
  "name": "wp-chessboard-solid",
  "version": "0.4.0",
  "description": "Web-native SolidJS 2 chessboard: DOM/SVG port of the wp_chessboard Flutter widget. No wasm, no runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mono424/wp_chessboard.git",
    "directory": "web"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "size": "npm run build && gzip -c dist/index.js | wc -c",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.1",
    "@solidjs/web": "^2.0.0-rc.1"
  },
  "devDependencies": {
    "@solidjs/signals": "2.0.0-rc.1",
    "@solidjs/vite-plugin": "3.0.0-next.31",
    "@solidjs/web": "2.0.0-rc.1",
    "solid-js": "2.0.0-rc.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "chess",
    "chessboard",
    "solid",
    "solidjs",
    "solid-js"
  ]
}
